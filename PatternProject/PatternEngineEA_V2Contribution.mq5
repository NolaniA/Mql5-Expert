#property strict
#property version "2.00"
#include <Trade/Trade.mqh>
CTrade trade;

input ulong InpMagicNumber=26080802;
input double InpRiskPercent=1.0;
input double InpDailyLossLimitPct=2.0;
input double InpMinimumRR=1.50;
input int InpMaxSpreadPoints=200;
input int InpSlippagePoints=30;
input bool InpAllowBuy=true;
input bool InpAllowSell=true;
input bool InpOnePositionOnly=true;
input ENUM_TIMEFRAMES InpPatternTF=PERIOD_M15;
input ENUM_TIMEFRAMES InpContextTF1=PERIOD_H1;
input ENUM_TIMEFRAMES InpContextTF2=PERIOD_H4;
input bool InpBlockSideway=true;
input bool InpBlockChoppy=true;
input bool InpBlockCompression=true;
input bool InpBlockLowVolatility=true;
input bool InpBlockConflictTrend=true;
input bool InpBlockExtendedMove=true;
input bool InpDoubleTopBottom=true;
input bool InpHeadShoulders=true;
input bool InpFlags=true;
input bool InpTriangles=true;
input bool InpWedges=true;
input bool InpBreakoutRetest=true;
input bool InpLiquiditySweep=true;
input int InpOnlyPattern=0;
input int InpTrendFilterMode=0;       // 0 none, 1 H1, 2 H4, 3 H1+H4
input int InpSweepQualityMode=20;     // 0 none, 1-5 BUY ablations, 10-13 SELL RR buckets, 20 V2 portfolio
input bool InpUseQualityScoring=true;
input int InpPatternMask=16383;       // bit 0=pattern 1, bit 13=pattern 14
input int InpATRPeriod=14;
input double InpSwingToleranceATR=0.30;
input double InpStopBufferATR=0.15;
input bool InpValidationBRBuyRejectRR5=false;
input bool InpValidationLSSLock025After1R=false;
input int InpResearchTrailingMode=0; // 0 none, 1 T1, 2 T2, 3 T3, 4 T4, 5 T5, 6 T6
input bool InpResearchPathDiagnostics=false;
input int InpLevelFailureExitMode=0; // 0 none, 1 full, 2 partial50, 3 partial75, 4 breakeven, 5 structure, 6 two closes
input int InpLevelFailureManagePatternId=0; // 11 BREAKOUT_RETEST_BUY, 13 LIQUIDITY_SWEEP_BUY
input bool InpValidationLSBReclaimOnly=false;

struct PatternSignal { bool valid; bool buy; string name; double entry; double sl; double tp; double sl_distance; double tp_distance; double rr; double confidence; double atr; double pattern_height; double measured_move; double structure_price; double stop_buffer; int h1_trend; int h4_trend; double atr_ratio; int hour; double sweep_atr; double wick_body_ratio; double close_location; double reclaim_distance; double reclaim_atr; double entry_lateness; double structure_quality; double score; double score_pattern; double score_trend; double score_rr; double score_lateness; double score_structure; double score_sweep; double br_breakout_body_atr; double br_breakout_range_atr; double br_retest_depth_atr; double br_distance_from_breakout_atr; int br_bars_since_breakout; double br_breakout_volume; double br_ema20_slope; double br_ema50_slope; double br_price_vs_ema20; double br_price_vs_ema50; double br_dist_recent_swing_high_atr; };

datetime g_last_bar_time=0;
int g_next_plan_id=1;
int g_pending_plan_id=0;
bool g_pending_buy=false;
double g_pending_sl=0,g_pending_tp=0,g_pending_sl_dist=0;
double g_pending_structure=0,g_pending_origin_high=0,g_pending_origin_low=0;
string g_pending_name="";
bool g_path_active=false;
int g_path_id=0;
bool g_path_buy=false;
datetime g_path_entry_time=0;
double g_path_entry=0,g_path_sl=0,g_path_tp=0,g_path_sl_dist=0,g_path_mfe=0,g_path_mae=0,g_path_max_fav_price=0,g_path_max_adv_price=0;
double g_path_initial_sl=0;
datetime g_path_last_trail_bar=0;
double g_path_structure=0,g_path_origin_high=0,g_path_origin_low=0,g_research_mfe_r=-DBL_MAX,g_research_mae_r=0;
int g_research_bar_count=0,g_research_mfe_bar=0,g_research_hit05_bar=0,g_research_hit10_bar=0,g_research_hit15_bar=0,g_research_hit20_bar=0;
bool g_level_failure_managed=false;
int g_level_failure_consecutive=0;
bool g_path_hit025=false,g_path_hit050=false,g_path_hit075=false,g_path_hit100=false,g_path_hit150=false,g_path_be_after050=false,g_path_be_after075=false,g_path_be_after100=false,g_path_be_after150=false,g_path_lock025_after100=false;
bool g_path_lock025_applied=false;
string g_path_name="";
long diag_bars=0,diag_block_sideway=0,diag_block_choppy=0,diag_block_compression=0,diag_block_low_vol=0,diag_block_conflict=0,diag_block_extended=0;
long diag_double_bottom=0,diag_double_top=0,diag_hs=0,diag_inverse_hs=0,diag_bull_flag=0,diag_bear_flag=0,diag_ascending_triangle=0,diag_descending_triangle=0,diag_falling_wedge=0,diag_rising_wedge=0,diag_breakout_retest_buy=0,diag_breakout_retest_sell=0,diag_liquidity_buy=0,diag_liquidity_sell=0;
long diag_no_pattern=0,diag_single_candidate=0,diag_multiple_candidates=0,diag_direction_conflict=0,diag_rr_rejected=0,diag_execution_rr_rejected=0,diag_spread_rejected=0,diag_existing_position=0,diag_daily_risk=0,diag_sizing_rejected=0,diag_invalid_stop=0,diag_market_session=0,diag_order_check_failed=0,diag_signal_disabled=0,diag_tick_missing=0,diag_orders_attempted=0,diag_orders_success=0,diag_orders_failed=0,diag_quality_rejected=0,diag_trend_rejected=0,diag_validation_rejected=0,diag_management_actions=0,diag_management_failures=0;

bool LoadRates(ENUM_TIMEFRAMES tf,int count,MqlRates &rates[]){ ArraySetAsSeries(rates,true); return CopyRates(_Symbol,tf,0,count,rates)>=count; }
double TrueRange(const MqlRates &c,const MqlRates &p){ return MathMax(c.high-c.low,MathMax(MathAbs(c.high-p.close),MathAbs(c.low-p.close))); }
double ATR(ENUM_TIMEFRAMES tf,int period,int shift=1){ MqlRates r[]; int n=period+shift+2; if(!LoadRates(tf,n,r)) return 0; double s=0; for(int i=shift;i<shift+period;i++) s+=TrueRange(r[i],r[i+1]); return s/period; }
double AvgATR(ENUM_TIMEFRAMES tf,int period,int samples){ double s=0; int n=0; for(int i=1;i<=samples;i++){ double a=ATR(tf,period,i); if(a>0){s+=a;n++;}} return n?s/n:0; }
double SMA(ENUM_TIMEFRAMES tf,int period,int shift){ MqlRates r[]; if(!LoadRates(tf,period+shift+2,r)) return 0; double s=0; for(int i=shift;i<shift+period;i++) s+=r[i].close; return s/period; }
double EMA(ENUM_TIMEFRAMES tf,int period,int shift){ MqlRates r[]; int count=period*5+shift+10; if(!LoadRates(tf,count,r)) return 0; double k=2.0/(period+1.0),ema=r[count-1].close; for(int i=count-2;i>=shift;i--) ema=r[i].close*k+ema*(1.0-k); return ema; }
int Trend(ENUM_TIMEFRAMES tf){ double f=SMA(tf,20,1),s=SMA(tf,50,1); if(f==0||s==0) return 0; return f>s?1:(f<s?-1:0); }
double HH(MqlRates &r[],int start,int count){ double v=-DBL_MAX; for(int i=start;i<start+count;i++) v=MathMax(v,r[i].high); return v; }
double LL(MqlRates &r[],int start,int count){ double v=DBL_MAX; for(int i=start;i<start+count;i++) v=MathMin(v,r[i].low); return v; }
bool SwingHigh(MqlRates &r[],int sh,int strength=2){ for(int i=1;i<=strength;i++) if(r[sh].high<=r[sh-i].high||r[sh].high<=r[sh+i].high) return false; return true; }
bool SwingLow(MqlRates &r[],int sh,int strength=2){ for(int i=1;i<=strength;i++) if(r[sh].low>=r[sh-i].low||r[sh].low>=r[sh+i].low) return false; return true; }
void Reset(PatternSignal &s){ s.valid=false;s.buy=false;s.name="";s.entry=0;s.sl=0;s.tp=0;s.sl_distance=0;s.tp_distance=0;s.rr=0;s.confidence=0;s.atr=0;s.pattern_height=0;s.measured_move=0;s.structure_price=0;s.stop_buffer=0;s.h1_trend=0;s.h4_trend=0;s.atr_ratio=0;s.hour=0;s.sweep_atr=0;s.wick_body_ratio=0;s.close_location=0;s.reclaim_distance=0;s.reclaim_atr=0;s.entry_lateness=0;s.structure_quality=0;s.score=0;s.score_pattern=0;s.score_trend=0;s.score_rr=0;s.score_lateness=0;s.score_structure=0;s.score_sweep=0;s.br_breakout_body_atr=0;s.br_breakout_range_atr=0;s.br_retest_depth_atr=0;s.br_distance_from_breakout_atr=0;s.br_bars_since_breakout=0;s.br_breakout_volume=0;s.br_ema20_slope=0;s.br_ema50_slope=0;s.br_price_vs_ema20=0;s.br_price_vs_ema50=0;s.br_dist_recent_swing_high_atr=0; }
void Finalize(PatternSignal &s){ if(!s.valid) return; if(s.buy){s.sl_distance=s.entry-s.sl;s.tp_distance=s.tp-s.entry;}else{s.sl_distance=s.sl-s.entry;s.tp_distance=s.entry-s.tp;} if(s.sl_distance<=0||s.tp_distance<=0){s.valid=false;return;} s.rr=s.tp_distance/s.sl_distance; if(s.rr<=0)s.valid=false; }
void Add(PatternSignal &a[],PatternSignal &s){ if(!s.valid)return; int n=ArraySize(a);ArrayResize(a,n+1);a[n]=s; }
bool PatternMaskOK(int id){int bit=1;for(int i=1;i<id;i++)bit*=2;return (InpPatternMask&bit)!=0;}
bool OnlyPattern(int id){return (InpOnlyPattern==0||InpOnlyPattern==id)&&PatternMaskOK(id);}
string BarKey(){return IntegerToString((long)iTime(_Symbol,InpPatternTF,1));}
string BarTimestamp(){string ts=TimeToString(iTime(_Symbol,InpPatternTF,1),TIME_DATE|TIME_MINUTES);StringReplace(ts," ","T");return ts;}
void FillContext(PatternSignal &s,double atr){s.atr=atr;s.stop_buffer=atr*InpStopBufferATR;s.h1_trend=Trend(InpContextTF1);s.h4_trend=Trend(InpContextTF2);double avg=AvgATR(InpPatternTF,InpATRPeriod,50);s.atr_ratio=(avg>0?atr/avg:0);MqlDateTime dt;TimeToStruct(iTime(_Symbol,InpPatternTF,1),dt);s.hour=dt.hour;}
void FillBreakRetestDiagnostics(PatternSignal &s,MqlRates &r[],double level,double atr){double e20=EMA(InpPatternTF,20,1),e20p=EMA(InpPatternTF,20,4),e50=EMA(InpPatternTF,50,1),e50p=EMA(InpPatternTF,50,4);s.br_breakout_body_atr=(atr>0?MathAbs(r[2].close-r[2].open)/atr:0);s.br_breakout_range_atr=(atr>0?(r[2].high-r[2].low)/atr:0);s.br_breakout_volume=(double)r[2].tick_volume;s.br_bars_since_breakout=1;if(s.buy){s.br_retest_depth_atr=(atr>0?MathMax(0.0,level-r[1].low)/atr:0);s.br_distance_from_breakout_atr=(atr>0?(r[1].close-level)/atr:0);s.br_dist_recent_swing_high_atr=(atr>0?(HH(r,2,20)-r[1].close)/atr:0);}else{s.br_retest_depth_atr=(atr>0?MathMax(0.0,r[1].high-level)/atr:0);s.br_distance_from_breakout_atr=(atr>0?(level-r[1].close)/atr:0);s.br_dist_recent_swing_high_atr=(atr>0?(r[1].close-LL(r,2,20))/atr:0);}s.br_ema20_slope=(atr>0&&e20>0&&e20p>0?(e20-e20p)/atr:0);s.br_ema50_slope=(atr>0&&e50>0&&e50p>0?(e50-e50p)/atr:0);s.br_price_vs_ema20=(atr>0&&e20>0?(r[1].close-e20)/atr:0);s.br_price_vs_ema50=(atr>0&&e50>0?(r[1].close-e50)/atr:0);}
string RRReason(PatternSignal &s){bool target_ok=s.buy?(s.tp>s.entry):(s.tp<s.entry);bool stop_ok=s.buy?(s.sl<s.entry):(s.sl>s.entry);if(s.sl_distance<=0)return "INVALID_SL_DISTANCE";if(!target_ok)return "TARGET_WRONG_SIDE";if(!stop_ok)return "SL_WRONG_SIDE";if(s.rr<0)return "RR_NEGATIVE";if(s.rr<InpMinimumRR)return "RR_BELOW_MIN";return "PASS";}
double Clamp(double v,double lo,double hi){return MathMax(lo,MathMin(hi,v));}
double Consumption(PatternSignal &s){if(s.measured_move<=0)return 1.0;double consumed=s.buy?(s.entry-s.structure_price):(s.structure_price-s.entry);return consumed/s.measured_move;}
bool LateEntry(PatternSignal &s,double max_consumed){s.entry_lateness=Consumption(s);return s.entry_lateness>max_consumed;}
bool TrendAligned(PatternSignal &s,int trend){if(trend==0)return false;return s.buy?(trend>0):(trend<0);}
bool TrendModeOK(PatternSignal &s){if(InpTrendFilterMode==0)return true;bool h1=TrendAligned(s,s.h1_trend),h4=TrendAligned(s,s.h4_trend);if(InpTrendFilterMode==1)return h1;if(InpTrendFilterMode==2)return h4;if(InpTrendFilterMode==3)return h1&&h4;return true;}
bool InRange(double value,double lo,double hi){return value>=lo&&value<=hi;}
bool SweepQualityOK(PatternSignal &s,string &reason){if(StringFind(s.name,"LIQUIDITY_SWEEP")!=0)return true;bool sweep=InRange(s.sweep_atr,0.10,0.50),reclaim=InRange(s.reclaim_atr,0.10,0.50),wick=InRange(s.wick_body_ratio,0.50,2.00);if(InpSweepQualityMode==0)return true;if(InpSweepQualityMode==1){reason="SWEEP_DISTANCE_ONLY";return sweep;}if(InpSweepQualityMode==2){reason="RECLAIM_ONLY";return reclaim;}if(InpSweepQualityMode==3){reason="WICK_BODY_ONLY";return wick;}if(InpSweepQualityMode==4){reason="SWEEP_RECLAIM";return sweep&&reclaim;}if(InpSweepQualityMode==5){reason="SWEEP_RECLAIM_WICK";return sweep&&reclaim&&wick;}if(InpSweepQualityMode==10){reason="SELL_RR_1_5_2_0";return !s.buy&&s.rr>=1.5&&s.rr<2.0;}if(InpSweepQualityMode==11){reason="SELL_RR_2_0_3_0";return !s.buy&&s.rr>=2.0&&s.rr<3.0;}if(InpSweepQualityMode==12){reason="SELL_RR_3_0_5_0";return !s.buy&&s.rr>=3.0&&s.rr<5.0;}if(InpSweepQualityMode==13){reason="SELL_RR_GE_5_0";return !s.buy&&s.rr>=5.0;}if(InpSweepQualityMode==20){reason="V2_PORTFOLIO_SWEEP";if(s.buy){int hits=(sweep?1:0)+(reclaim?1:0)+(wick?1:0);return hits>=2;}return s.rr>=2.0&&s.rr<3.0;}return true;}
void ScoreCandidate(PatternSignal &s){s.score_pattern=s.confidence;s.score_trend=(TrendAligned(s,s.h1_trend)?0.18:-0.08)+(TrendAligned(s,s.h4_trend)?0.18:-0.08);s.score_rr=Clamp(1.0-MathAbs(s.rr-2.2)/2.8,0.0,1.0);s.score_lateness=Clamp(1.0-s.entry_lateness/0.35,0.0,1.0);s.structure_quality=(s.atr>0?s.measured_move/s.atr:0);s.score_structure=Clamp(s.structure_quality/3.0,0.0,1.0);if(StringFind(s.name,"LIQUIDITY_SWEEP")==0){s.score_sweep=(InRange(s.sweep_atr,0.10,0.50)?0.34:0)+(InRange(s.reclaim_atr,0.10,0.50)?0.33:0)+(InRange(s.wick_body_ratio,0.50,2.00)?0.33:0);}else{s.score_sweep=0.15;}s.score=s.score_pattern+s.score_trend+s.score_rr+s.score_lateness+s.score_structure+s.score_sweep;}
void LogCandidate(PatternSignal &s){PrintFormat("PATTERN_CANDIDATE bar=%s timestamp=%s name=%s direction=%s entry=%.3f sl=%.3f tp=%.3f rr=%.6f sl_dist=%.3f tp_dist=%.3f atr=%.6f pattern_height=%.3f measured_move=%.3f structure=%.3f stop_buffer=%.3f h1_trend=%d h4_trend=%d atr_ratio=%.6f hour=%d entry_lateness=%.6f structure_quality=%.6f rr_reason=%s",BarKey(),BarTimestamp(),s.name,s.buy?"BUY":"SELL",s.entry,s.sl,s.tp,s.rr,s.sl_distance,s.tp_distance,s.atr,s.pattern_height,s.measured_move,s.structure_price,s.stop_buffer,s.h1_trend,s.h4_trend,s.atr_ratio,s.hour,s.entry_lateness,s.structure_quality,RRReason(s));}
void LogScore(PatternSignal &s){PrintFormat("PATTERN_SCORE bar=%s timestamp=%s name=%s direction=%s entry=%.3f sl=%.3f tp=%.3f planned_rr=%.6f score=%.6f pattern_quality=%.6f trend_quality=%.6f rr_quality=%.6f lateness_quality=%.6f structure_quality_component=%.6f sweep_quality=%.6f entry_lateness=%.6f structure_quality=%.6f sweep_distance_atr=%.6f reclaim_distance_atr=%.6f wick_body_ratio=%.6f",BarKey(),BarTimestamp(),s.name,s.buy?"BUY":"SELL",s.entry,s.sl,s.tp,s.rr,s.score,s.score_pattern,s.score_trend,s.score_rr,s.score_lateness,s.score_structure,s.score_sweep,s.entry_lateness,s.structure_quality,s.sweep_atr,s.reclaim_atr,s.wick_body_ratio);}
void LogTradeFeature(int id,PatternSignal &s,double planned_rr,double target_distance){PrintFormat("PATTERN_TRADE_FEATURE id=%d bar=%s timestamp=%s name=%s direction=%s h1_trend=%d h4_trend=%d atr=%.6f atr_ratio=%.6f hour=%d sweep_atr=%.6f wick_body_ratio=%.6f close_location=%.6f reclaim_distance=%.3f reclaim_atr=%.6f target_distance=%.3f planned_rr=%.6f measured_move=%.3f pattern_height=%.3f structure=%.3f entry_lateness=%.6f score=%.6f breakout_body_atr=%.6f breakout_range_atr=%.6f retest_depth_atr=%.6f distance_from_breakout_atr=%.6f bars_since_breakout=%d breakout_volume=%.0f ema20_slope=%.6f ema50_slope=%.6f price_vs_ema20=%.6f price_vs_ema50=%.6f distance_to_recent_swing_high=%.6f",id,BarKey(),BarTimestamp(),s.name,s.buy?"BUY":"SELL",s.h1_trend,s.h4_trend,s.atr,s.atr_ratio,s.hour,s.sweep_atr,s.wick_body_ratio,s.close_location,s.reclaim_distance,s.reclaim_atr,target_distance,planned_rr,s.measured_move,s.pattern_height,s.structure_price,s.entry_lateness,s.score,s.br_breakout_body_atr,s.br_breakout_range_atr,s.br_retest_depth_atr,s.br_distance_from_breakout_atr,s.br_bars_since_breakout,s.br_breakout_volume,s.br_ema20_slope,s.br_ema50_slope,s.br_price_vs_ema20,s.br_price_vs_ema50,s.br_dist_recent_swing_high_atr);MqlRates r[];if(LoadRates(InpPatternTF,60,r)){double atr=s.atr,close=r[1].close,e20=EMA(InpPatternTF,20,1),e20p=EMA(InpPatternTF,20,4),e50=EMA(InpPatternTF,50,1),e50p=EMA(InpPatternTF,50,4),hi20=HH(r,2,20),lo20=LL(r,2,20);double e20s=(atr>0&&e20>0&&e20p>0?(e20-e20p)/atr:0),e50s=(atr>0&&e50>0&&e50p>0?(e50-e50p)/atr:0);double p20=(atr>0&&e20>0?(close-e20)/atr:0),p50=(atr>0&&e50>0?(close-e50)/atr:0);double dh=(atr>0?(hi20-close)/atr:0),dl=(atr>0?(close-lo20)/atr:0),rrange=(atr>0?(hi20-lo20)/atr:0);PrintFormat("PATTERN_TRADE_FEATURE id=%d ema20=%.6f ema50=%.6f ema20_slope_atr=%.6f ema50_slope_atr=%.6f price_distance_ema20_atr=%.6f price_distance_ema50_atr=%.6f distance_recent_swing_high_atr=%.6f distance_recent_swing_low_atr=%.6f recent_market_range_atr=%.6f broker_hour=%d",id,e20,e50,e20s,e50s,p20,p50,dh,dl,rrange,s.hour);if(s.name=="ASCENDING_TRIANGLE"){double res=HH(r,3,12),old=LL(r,9,6),recent=LL(r,3,6),height=res-MathMin(old,recent),tol=atr*0.20;int touches=0;for(int i=3;i<15;i++)if(MathAbs(r[i].high-res)<=tol)touches++;double oldw=res-old,recentw=res-recent,compression=(oldw>0?recentw/oldw:0),slope=(atr>0?(recent-old)/atr:0),height_atr=(atr>0?height/atr:0),br=(atr>0?(close-res)/atr:0);PrintFormat("PATTERN_TRADE_FEATURE id=%d resistance_level=%.3f resistance_touches=%d ascending_low_slope_atr=%.6f triangle_height_atr=%.6f compression_ratio=%.6f triangle_breakout_strength_atr=%.6f triangle_breakout_volume=%.0f triangle_distance_from_breakout_atr=%.6f triangle_old_low=%.3f triangle_recent_low=%.3f",id,res,touches,slope,height_atr,compression,br,(double)r[1].tick_volume,br,old,recent);}if(StringFind(s.name,"LIQUIDITY_SWEEP")==0){double range=r[1].high-r[1].low,body=MathAbs(r[1].close-r[1].open),opposing_atr=(atr>0?target_distance/atr:0),sweep_range_atr=(atr>0?range/atr:0),sweep_body_atr=(atr>0?body/atr:0);PrintFormat("PATTERN_TRADE_FEATURE id=%d swept_level=%.3f sweep_distance_atr=%.6f reclaim_distance_atr=%.6f distance_to_next_opposing_structure_atr=%.6f sweep_age=1 sweep_candle_range_atr=%.6f sweep_candle_body_atr=%.6f sweep_volume=%.0f",id,s.structure_price,s.sweep_atr,s.reclaim_atr,opposing_atr,sweep_range_atr,sweep_body_atr,(double)r[1].tick_volume);}}}

bool IsSideway(){ MqlRates r[]; if(!LoadRates(InpPatternTF,30,r))return false; double a=ATR(InpPatternTF,InpATRPeriod); if(a<=0)return false; return (HH(r,1,20)-LL(r,1,20)<=a*4.0 && MathAbs(r[1].close-r[20].close)<=a*1.25); }
bool IsChoppy(){ MqlRates r[]; if(!LoadRates(InpPatternTF,25,r))return false; int alt=0,ov=0; for(int i=1;i<19;i++){ bool b1=r[i].close>r[i].open,b2=r[i+1].close>r[i+1].open;if(b1!=b2)alt++;if(MathMin(r[i].high,r[i+1].high)>MathMax(r[i].low,r[i+1].low))ov++; } return alt>=11&&ov>=14; }
bool IsCompression(){ MqlRates r[]; if(!LoadRates(InpPatternTF,25,r))return false; double recent=HH(r,1,8)-LL(r,1,8),old=HH(r,9,8)-LL(r,9,8); return old>0&&recent<old*0.65; }
bool IsLowVol(){ double c=ATR(InpPatternTF,InpATRPeriod),h=AvgATR(InpPatternTF,InpATRPeriod,50);return c>0&&h>0&&c<h*0.60; }
bool IsConflict(){ int a=Trend(InpContextTF1),b=Trend(InpContextTF2);return a!=0&&b!=0&&a!=b; }
bool IsExtended(){ MqlRates r[];if(!LoadRates(InpPatternTF,30,r))return false;double a=ATR(InpPatternTF,InpATRPeriod),m=SMA(InpPatternTF,20,1);return a>0&&m>0&&MathAbs(r[1].close-m)>a*2.75; }
bool Blocked(string &reason){ if(InpBlockSideway&&IsSideway()){reason="SIDEWAY";diag_block_sideway++;return true;} if(InpBlockChoppy&&IsChoppy()){reason="CHOPPY";diag_block_choppy++;return true;} if(InpBlockCompression&&IsCompression()){reason="COMPRESSION";diag_block_compression++;return true;} if(InpBlockLowVolatility&&IsLowVol()){reason="LOW_VOLATILITY";diag_block_low_vol++;return true;} if(InpBlockConflictTrend&&IsConflict()){reason="CONFLICT_TREND";diag_block_conflict++;return true;} if(InpBlockExtendedMove&&IsExtended()){reason="EXTENDED_MOVE";diag_block_extended++;return true;} return false; }

PatternSignal DoubleBottom(){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,50,r))return s;double a=ATR(InpPatternTF,InpATRPeriod);int x=-1,y=-1;for(int i=3;i<35;i++)if(SwingLow(r,i)){if(x<0)x=i;else{y=i;break;}} if(x<0||y<0||MathAbs(r[x].low-r[y].low)>a*InpSwingToleranceATR)return s;int st=MathMin(x,y),ct=MathAbs(x-y)+1;double neck=HH(r,st,ct);if(!(r[2].close>neck&&r[1].low<=neck+a*0.20&&r[1].close>neck))return s;double bottom=MathMin(r[x].low,r[y].low),h=neck-bottom;if(h<=0)return s;s.valid=true;s.buy=true;s.name="DOUBLE_BOTTOM";s.entry=r[1].close;s.sl=MathMin(r[1].low,neck-a*0.05)-a*InpStopBufferATR;s.tp=neck+h;s.confidence=1.10;s.pattern_height=h;s.measured_move=h;s.structure_price=neck;FillContext(s,a);if(LateEntry(s,0.35)){s.valid=false;return s;}Finalize(s);if(s.valid)diag_double_bottom++;return s; }
PatternSignal DoubleTop(){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,50,r))return s;double a=ATR(InpPatternTF,InpATRPeriod);int x=-1,y=-1;for(int i=3;i<35;i++)if(SwingHigh(r,i)){if(x<0)x=i;else{y=i;break;}} if(x<0||y<0||MathAbs(r[x].high-r[y].high)>a*InpSwingToleranceATR)return s;int st=MathMin(x,y),ct=MathAbs(x-y)+1;double neck=LL(r,st,ct);if(!(r[2].close<neck&&r[1].high>=neck-a*0.20&&r[1].close<neck))return s;double top=MathMax(r[x].high,r[y].high),h=top-neck;if(h<=0)return s;s.valid=true;s.buy=false;s.name="DOUBLE_TOP";s.entry=r[1].close;s.sl=MathMax(r[1].high,neck+a*0.05)+a*InpStopBufferATR;s.tp=neck-h;s.confidence=1.10;s.pattern_height=h;s.measured_move=h;s.structure_price=neck;FillContext(s,a);if(LateEntry(s,0.35)){s.valid=false;return s;}Finalize(s);if(s.valid)diag_double_top++;return s; }
PatternSignal HS(bool inv){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,60,r))return s;double a=ATR(InpPatternTF,InpATRPeriod);int sw[3]={-1,-1,-1},f=0;for(int i=3;i<45&&f<3;i++){bool ok=inv?SwingLow(r,i):SwingHigh(r,i);if(ok)sw[f++]=i;}if(f<3)return s;int right=sw[0],head=sw[1],left=sw[2];if(!inv){double L=r[left].high,H=r[head].high,R=r[right].high;if(H<=L||H<=R||MathAbs(L-R)>a*0.75)return s;double neck=MathMin(LL(r,right,head-right+1),LL(r,head,left-head+1));if(r[1].close>=neck)return s;s.valid=true;s.buy=false;s.name="HEAD_SHOULDERS";s.entry=r[1].close;s.sl=R+a*InpStopBufferATR;s.tp=neck-(H-neck);s.pattern_height=H-neck;s.measured_move=H-neck;s.structure_price=neck;FillContext(s,a);diag_hs++;}else{double L=r[left].low,H=r[head].low,R=r[right].low;if(H>=L||H>=R||MathAbs(L-R)>a*0.75)return s;double neck=MathMax(HH(r,right,head-right+1),HH(r,head,left-head+1));if(r[1].close<=neck)return s;s.valid=true;s.buy=true;s.name="INVERSE_HEAD_SHOULDERS";s.entry=r[1].close;s.sl=R-a*InpStopBufferATR;s.tp=neck+(neck-H);s.pattern_height=neck-H;s.measured_move=neck-H;s.structure_price=neck;FillContext(s,a);diag_inverse_hs++;}s.confidence=1.1;Finalize(s);return s; }
PatternSignal Flag(bool buy){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,30,r))return s;double a=ATR(InpPatternTF,InpATRPeriod),pole=buy?r[5].close-r[12].close:r[12].close-r[5].close;if(pole<a*2)return s;double hi=HH(r,2,5),lo=LL(r,2,5);if(hi-lo>pole*0.60)return s;if(buy){if(r[1].close<=hi)return s;s.valid=true;s.buy=true;s.name="BULL_FLAG";s.entry=r[1].close;s.sl=lo-a*InpStopBufferATR;s.tp=s.entry+pole;s.pattern_height=hi-lo;s.measured_move=pole;s.structure_price=hi;FillContext(s,a);diag_bull_flag++;}else{if(r[1].close>=lo)return s;s.valid=true;s.buy=false;s.name="BEAR_FLAG";s.entry=r[1].close;s.sl=hi+a*InpStopBufferATR;s.tp=s.entry-pole;s.pattern_height=hi-lo;s.measured_move=pole;s.structure_price=lo;FillContext(s,a);diag_bear_flag++;}s.confidence=1;Finalize(s);return s; }
PatternSignal Triangle(bool buy){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,30,r))return s;double a=ATR(InpPatternTF,InpATRPeriod);if(buy){double res=HH(r,3,12),old=LL(r,9,6),recent=LL(r,3,6),h=res-MathMin(old,recent);if(recent<=old+a*0.20||r[1].close<=res)return s;s.valid=true;s.buy=true;s.name="ASCENDING_TRIANGLE";s.entry=r[1].close;s.sl=recent-a*InpStopBufferATR;s.tp=res+h;s.pattern_height=h;s.measured_move=h;s.structure_price=res;FillContext(s,a);diag_ascending_triangle++;}else{double sup=LL(r,3,12),old=HH(r,9,6),recent=HH(r,3,6),h=MathMax(old,recent)-sup;if(recent>=old-a*0.20||r[1].close>=sup)return s;s.valid=true;s.buy=false;s.name="DESCENDING_TRIANGLE";s.entry=r[1].close;s.sl=recent+a*InpStopBufferATR;s.tp=sup-h;s.pattern_height=h;s.measured_move=h;s.structure_price=sup;FillContext(s,a);diag_descending_triangle++;}Finalize(s);return s; }
PatternSignal Wedge(bool falling){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,30,r))return s;double a=ATR(InpPatternTF,InpATRPeriod),oh=HH(r,10,7),rh=HH(r,3,7),ol=LL(r,10,7),rl=LL(r,3,7),ow=oh-ol,rw=rh-rl;if(rw>=ow)return s;if(falling){if(!(rh<oh&&rl<ol)||r[1].close<=rh)return s;s.valid=true;s.buy=true;s.name="FALLING_WEDGE";s.entry=r[1].close;s.sl=rl-a*InpStopBufferATR;s.tp=s.entry+ow;s.pattern_height=ow;s.measured_move=ow;s.structure_price=rh;FillContext(s,a);diag_falling_wedge++;}else{if(!(rh>oh&&rl>ol)||r[1].close>=rl)return s;s.valid=true;s.buy=false;s.name="RISING_WEDGE";s.entry=r[1].close;s.sl=rh+a*InpStopBufferATR;s.tp=s.entry-ow;s.pattern_height=ow;s.measured_move=ow;s.structure_price=rl;FillContext(s,a);diag_rising_wedge++;}Finalize(s);return s; }
PatternSignal BreakRetest(bool buy){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,30,r))return s;double a=ATR(InpPatternTF,InpATRPeriod);if(buy){double res=HH(r,4,12);if(!(r[2].close>res&&r[1].low<=res+a*0.15&&r[1].close>res))return s;double low=LL(r,4,12),h=res-low;if(h<=0)return s;s.valid=true;s.buy=true;s.name="BREAKOUT_RETEST_BUY";s.entry=r[1].close;s.sl=MathMin(r[1].low,res-a*0.05)-a*InpStopBufferATR;s.tp=res+h;s.pattern_height=h;s.measured_move=h;s.structure_price=res;FillContext(s,a);FillBreakRetestDiagnostics(s,r,res,a);if(LateEntry(s,0.35)){s.valid=false;return s;}Finalize(s);if(s.valid)diag_breakout_retest_buy++;}else{double sup=LL(r,4,12);if(!(r[2].close<sup&&r[1].high>=sup-a*0.15&&r[1].close<sup))return s;double high=HH(r,4,12),h=high-sup;if(h<=0)return s;s.valid=true;s.buy=false;s.name="BREAKOUT_RETEST_SELL";s.entry=r[1].close;s.sl=MathMax(r[1].high,sup+a*0.05)+a*InpStopBufferATR;s.tp=sup-h;s.pattern_height=h;s.measured_move=h;s.structure_price=sup;FillContext(s,a);FillBreakRetestDiagnostics(s,r,sup,a);if(LateEntry(s,0.35)){s.valid=false;return s;}Finalize(s);if(s.valid)diag_breakout_retest_sell++;}return s; }
PatternSignal Sweep(bool buy){ PatternSignal s;Reset(s);MqlRates r[];if(!LoadRates(InpPatternTF,30,r))return s;double a=ATR(InpPatternTF,InpATRPeriod);double body=MathAbs(r[1].close-r[1].open),range=r[1].high-r[1].low;if(buy){double prior=LL(r,2,10);if(!(r[1].low<prior&&r[1].close>prior&&r[1].close>r[1].open))return s;s.valid=true;s.buy=true;s.name="LIQUIDITY_SWEEP_BUY";s.entry=r[1].close;s.sl=r[1].low-a*InpStopBufferATR;s.tp=HH(r,2,15);s.structure_price=prior;s.pattern_height=s.tp-prior;s.measured_move=s.tp-prior;s.sweep_atr=(a>0?(prior-r[1].low)/a:0);s.wick_body_ratio=(body>0?(MathMin(r[1].open,r[1].close)-r[1].low)/body:0);s.close_location=(range>0?(r[1].close-r[1].low)/range:0);s.reclaim_distance=r[1].close-prior;s.reclaim_atr=(a>0?s.reclaim_distance/a:0);FillContext(s,a);diag_liquidity_buy++;}else{double prior=HH(r,2,10);if(!(r[1].high>prior&&r[1].close<prior&&r[1].close<r[1].open))return s;s.valid=true;s.buy=false;s.name="LIQUIDITY_SWEEP_SELL";s.entry=r[1].close;s.sl=r[1].high+a*InpStopBufferATR;s.tp=LL(r,2,15);s.structure_price=prior;s.pattern_height=prior-s.tp;s.measured_move=prior-s.tp;s.sweep_atr=(a>0?(r[1].high-prior)/a:0);s.wick_body_ratio=(body>0?(r[1].high-MathMax(r[1].open,r[1].close))/body:0);s.close_location=(range>0?(r[1].high-r[1].close)/range:0);s.reclaim_distance=prior-r[1].close;s.reclaim_atr=(a>0?s.reclaim_distance/a:0);FillContext(s,a);diag_liquidity_sell++;}Finalize(s);return s; }

void DetectAll(PatternSignal &c[]){ArrayResize(c,0);PatternSignal s;if(InpDoubleTopBottom&&OnlyPattern(1)){s=DoubleBottom();Add(c,s);}if(InpDoubleTopBottom&&OnlyPattern(2)){s=DoubleTop();Add(c,s);}if(InpHeadShoulders&&OnlyPattern(3)){s=HS(false);Add(c,s);}if(InpHeadShoulders&&OnlyPattern(4)){s=HS(true);Add(c,s);}if(InpFlags&&OnlyPattern(5)){s=Flag(true);Add(c,s);}if(InpFlags&&OnlyPattern(6)){s=Flag(false);Add(c,s);}if(InpTriangles&&OnlyPattern(7)){s=Triangle(true);Add(c,s);}if(InpTriangles&&OnlyPattern(8)){s=Triangle(false);Add(c,s);}if(InpWedges&&OnlyPattern(9)){s=Wedge(true);Add(c,s);}if(InpWedges&&OnlyPattern(10)){s=Wedge(false);Add(c,s);}if(InpBreakoutRetest&&OnlyPattern(11)){s=BreakRetest(true);Add(c,s);}if(InpBreakoutRetest&&OnlyPattern(12)){s=BreakRetest(false);Add(c,s);}if(InpLiquiditySweep&&OnlyPattern(13)){s=Sweep(true);Add(c,s);}if(InpLiquiditySweep&&OnlyPattern(14)){s=Sweep(false);Add(c,s);}}
void FilterRR(PatternSignal &in[],PatternSignal &out[]){ArrayResize(out,0);string bar=BarKey();for(int i=0;i<ArraySize(in);i++){ScoreCandidate(in[i]);LogCandidate(in[i]);if(in[i].rr<InpMinimumRR){diag_rr_rejected++;continue;}if(InpValidationBRBuyRejectRR5&&in[i].name=="BREAKOUT_RETEST_BUY"&&in[i].rr>=5.0){diag_validation_rejected++;PrintFormat("PATTERN_VALIDATION_REJECT bar=%s name=%s direction=%s rule=BR_BUY_RR_GE_5 rr=%.6f",bar,in[i].name,in[i].buy?"BUY":"SELL",in[i].rr);continue;}if(InpValidationLSBReclaimOnly&&in[i].name=="LIQUIDITY_SWEEP_BUY"&&!InRange(in[i].reclaim_atr,0.10,0.50)){diag_validation_rejected++;PrintFormat("PATTERN_VALIDATION_REJECT bar=%s name=%s direction=%s rule=LSB_RECLAIM_EXISTING_0_10_0_50 rr=%.6f reclaim_distance_atr=%.6f",bar,in[i].name,in[i].buy?"BUY":"SELL",in[i].rr,in[i].reclaim_atr);continue;}if(!TrendModeOK(in[i])){diag_trend_rejected++;PrintFormat("PATTERN_TREND_REJECT bar=%s name=%s direction=%s mode=%d h1_trend=%d h4_trend=%d",bar,in[i].name,in[i].buy?"BUY":"SELL",InpTrendFilterMode,in[i].h1_trend,in[i].h4_trend);continue;}string qreason="";if(!SweepQualityOK(in[i],qreason)){diag_quality_rejected++;PrintFormat("PATTERN_QUALITY_REJECT bar=%s name=%s direction=%s mode=%d reason=%s rr=%.6f sweep_distance_atr=%.6f reclaim_distance_atr=%.6f wick_body_ratio=%.6f",bar,in[i].name,in[i].buy?"BUY":"SELL",InpSweepQualityMode,qreason,in[i].rr,in[i].sweep_atr,in[i].reclaim_atr,in[i].wick_body_ratio);continue;}LogScore(in[i]);PrintFormat("PATTERN_VALID bar=%s name=%s direction=%s entry=%.3f sl=%.3f tp=%.3f rr=%.2f sl_dist=%.3f tp_dist=%.3f score=%.6f",bar,in[i].name,in[i].buy?"BUY":"SELL",in[i].entry,in[i].sl,in[i].tp,in[i].rr,in[i].sl_distance,in[i].tp_distance,in[i].score);Add(out,in[i]);}}
bool Conflict(PatternSignal &a[]){bool b=false,s=false;for(int i=0;i<ArraySize(a);i++){if(a[i].buy)b=true;else s=true;}return b&&s;}
int Best(PatternSignal &a[]){if(ArraySize(a)==0)return -1;int best=0;for(int i=1;i<ArraySize(a);i++){if(InpUseQualityScoring){if(a[i].score>a[best].score)best=i;}else if(a[i].tp_distance>a[best].tp_distance)best=i;}return best;}

bool SpreadOK(){MqlTick t;if(!SymbolInfoTick(_Symbol,t)){diag_tick_missing++;return false;}double p=SymbolInfoDouble(_Symbol,SYMBOL_POINT);if(p<=0){diag_tick_missing++;return false;}if((t.ask-t.bid)/p>InpMaxSpreadPoints){diag_spread_rejected++;return false;}return true;}
bool HasPosition(){for(int i=PositionsTotal()-1;i>=0;i--){ulong ticket=PositionGetTicket(i);if(ticket==0)continue;if(PositionGetString(POSITION_SYMBOL)!=_Symbol)continue;if(PositionGetInteger(POSITION_MAGIC)==(long)InpMagicNumber)return true;}return false;}
double TodayPnL(){MqlDateTime dt;datetime now=TimeCurrent();TimeToStruct(now,dt);dt.hour=0;dt.min=0;dt.sec=0;datetime start=StructToTime(dt);if(!HistorySelect(start,now))return 0;double pnl=0;for(int i=0;i<HistoryDealsTotal();i++){ulong ticket=HistoryDealGetTicket(i);if(!ticket)continue;if(HistoryDealGetString(ticket,DEAL_SYMBOL)!=_Symbol)continue;if(HistoryDealGetInteger(ticket,DEAL_MAGIC)!=(long)InpMagicNumber)continue;if(HistoryDealGetInteger(ticket,DEAL_ENTRY)!=DEAL_ENTRY_OUT)continue;pnl+=HistoryDealGetDouble(ticket,DEAL_PROFIT)+HistoryDealGetDouble(ticket,DEAL_SWAP)+HistoryDealGetDouble(ticket,DEAL_COMMISSION);}return pnl;}
bool DailyOK(){double eq=AccountInfoDouble(ACCOUNT_EQUITY);if(eq<=0)return false;if(TodayPnL()<=-(eq*InpDailyLossLimitPct/100.0)){diag_daily_risk++;return false;}return true;}
double NormalizeVolumeDown(double v){double min=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN),max=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MAX),step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);if(step<=0)return 0;v=MathFloor(v/step)*step;v=MathMin(v,max);if(v<min)return 0;return NormalizeDouble(v,8);}
double Volume(bool buy,double entry,double sl){double eq=AccountInfoDouble(ACCOUNT_EQUITY),risk=eq*InpRiskPercent/100.0,one=0;if(eq<=0||risk<=0)return 0;ENUM_ORDER_TYPE type=buy?ORDER_TYPE_BUY:ORDER_TYPE_SELL;if(!OrderCalcProfit(type,_Symbol,1.0,entry,sl,one))return 0;double loss=MathAbs(one);if(loss<=0)return 0;double v=NormalizeVolumeDown(risk/loss);if(v<=0)return 0;double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP),min=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);for(int i=0;i<100&&v>=min;i++){double actual=0;if(!OrderCalcProfit(type,_Symbol,v,entry,sl,actual))return 0;if(MathAbs(actual)<=risk+0.01)return v;v=NormalizeVolumeDown(v-step);}return 0;}
double NPrice(double p){return NormalizeDouble(p,(int)SymbolInfoInteger(_Symbol,SYMBOL_DIGITS));}
double RiskCash(bool buy,double vol,double entry,double sl){double cash=0;ENUM_ORDER_TYPE type=buy?ORDER_TYPE_BUY:ORDER_TYPE_SELL;if(!OrderCalcProfit(type,_Symbol,vol,entry,sl,cash))return 0;return MathAbs(cash);}
string IsoTime(datetime t){string s=TimeToString(t,TIME_DATE|TIME_MINUTES);StringReplace(s," ","T");return s;}
void PathInit(int id,bool buy,double entry,double sl,double tp,datetime tm){g_path_active=true;g_path_id=id;g_path_buy=buy;g_path_entry_time=tm;g_path_entry=entry;g_path_sl=sl;g_path_initial_sl=sl;g_path_tp=tp;g_path_sl_dist=buy?entry-sl:sl-entry;if(g_path_sl_dist<=0)g_path_sl_dist=g_pending_sl_dist;g_path_mfe=0;g_path_mae=0;g_path_max_fav_price=entry;g_path_max_adv_price=entry;g_path_last_trail_bar=0;g_path_structure=g_pending_structure;g_path_origin_high=g_pending_origin_high;g_path_origin_low=g_pending_origin_low;g_research_mfe_r=0;g_research_mae_r=0;g_research_bar_count=0;g_research_mfe_bar=0;g_research_hit05_bar=0;g_research_hit10_bar=0;g_research_hit15_bar=0;g_research_hit20_bar=0;g_level_failure_managed=false;g_level_failure_consecutive=0;g_path_hit025=false;g_path_hit050=false;g_path_hit075=false;g_path_hit100=false;g_path_hit150=false;g_path_be_after050=false;g_path_be_after075=false;g_path_be_after100=false;g_path_be_after150=false;g_path_lock025_after100=false;g_path_lock025_applied=false;g_path_name=g_pending_name;g_pending_plan_id=0;}
void PathUpdatePrice(double price){if(!g_path_active)return;double fav=g_path_buy?price-g_path_entry:g_path_entry-price;double adv=g_path_buy?g_path_entry-price:price-g_path_entry;if(fav>g_path_mfe){g_path_mfe=fav;g_path_max_fav_price=price;}if(adv>g_path_mae){g_path_mae=adv;g_path_max_adv_price=price;}double r=(g_path_sl_dist>0?fav/g_path_sl_dist:0);if(r>=0.25)g_path_hit025=true;if(r>=0.50)g_path_hit050=true;if(r>=0.75)g_path_hit075=true;if(r>=1.00)g_path_hit100=true;if(r>=1.50)g_path_hit150=true;if(g_path_hit050&&r<=0.0)g_path_be_after050=true;if(g_path_hit075&&r<=0.0)g_path_be_after075=true;if(g_path_hit100&&r<=0.0)g_path_be_after100=true;if(g_path_hit150&&r<=0.0)g_path_be_after150=true;if(g_path_hit100&&r<=0.25)g_path_lock025_after100=true;}
void PathUpdateTick(){if(!g_path_active)return;MqlTick t;if(!SymbolInfoTick(_Symbol,t))return;PathUpdatePrice(g_path_buy?t.bid:t.ask);}
void LogResearchPathBar(){if(!InpResearchPathDiagnostics||!g_path_active||g_path_sl_dist<=0)return;MqlRates r[];if(!LoadRates(InpPatternTF,90,r))return;double atr=ATR(InpPatternTF,InpATRPeriod,1);if(atr<=0)return;double close=r[1].close,bar_fav=g_path_buy?r[1].high-g_path_entry:g_path_entry-r[1].low,bar_adv=g_path_buy?g_path_entry-r[1].low:r[1].high-g_path_entry,current_fav=g_path_buy?close-g_path_entry:g_path_entry-close;double current_r=current_fav/g_path_sl_dist,bar_mfe_r=bar_fav/g_path_sl_dist,bar_mae_r=bar_adv/g_path_sl_dist;if(bar_mfe_r>g_research_mfe_r){g_research_mfe_r=bar_mfe_r;g_research_mfe_bar=g_research_bar_count+1;}if(bar_mae_r>g_research_mae_r)g_research_mae_r=bar_mae_r;g_research_bar_count++;if(g_research_hit05_bar==0&&g_research_mfe_r>=0.50)g_research_hit05_bar=g_research_bar_count;if(g_research_hit10_bar==0&&g_research_mfe_r>=1.00)g_research_hit10_bar=g_research_bar_count;if(g_research_hit15_bar==0&&g_research_mfe_r>=1.50)g_research_hit15_bar=g_research_bar_count;if(g_research_hit20_bar==0&&g_research_mfe_r>=2.00)g_research_hit20_bar=g_research_bar_count;double giveback=(g_research_mfe_r>0?g_research_mfe_r-current_r:0),giveback_pct=(g_research_mfe_r>0?giveback/g_research_mfe_r:0);double swing_low=0,swing_high=0;int swing_low_shift=0,swing_high_shift=0;datetime swing_low_time=0,swing_high_time=0;ResearchRecentConfirmedSwing(true,swing_low,swing_low_shift,swing_low_time);ResearchRecentConfirmedSwing(false,swing_high,swing_high_shift,swing_high_time);double ema20=EMA(InpPatternTF,20,1),ema20p=EMA(InpPatternTF,20,4),ema50=EMA(InpPatternTF,50,1),ema50p=EMA(InpPatternTF,50,4),avg_atr=AvgATR(InpPatternTF,InpATRPeriod,50);double ema20s=(ema20>0&&ema20p>0?(ema20-ema20p)/atr:0),ema50s=(ema50>0&&ema50p>0?(ema50-ema50p)/atr:0),atr_ratio=(avg_atr>0?atr/avg_atr:0);double move3=g_path_buy?(r[1].close-r[4].close)/atr:(r[4].close-r[1].close)/atr,move5=g_path_buy?(r[1].close-r[6].close)/atr:(r[6].close-r[1].close)/atr,prev3=g_path_buy?(r[4].close-r[7].close)/atr:(r[7].close-r[4].close)/atr;double body=MathAbs(r[1].close-r[1].open),range=r[1].high-r[1].low,wick_body=(body>0?range/body:0),close_location=(range>0?(r[1].close-r[1].low)/range:0);PrintFormat("PATTERN_PATH_BAR id=%d timestamp=%s bar_index=%d name=%s direction=%s open=%.3f high=%.3f low=%.3f close=%.3f prev_open=%.3f prev_high=%.3f prev_low=%.3f prev_close=%.3f current_r=%.6f bar_mfe_r=%.6f bar_mae_r=%.6f running_mfe_r=%.6f running_mae_r=%.6f giveback_r=%.6f giveback_percent=%.6f bars_since_entry=%d bars_since_mfe=%d bars_since_0_5r=%d bars_since_1_0r=%d bars_since_1_5r=%d bars_since_2_0r=%d atr=%.6f atr_ratio=%.6f ema20=%.6f ema50=%.6f ema20_slope_atr=%.6f ema50_slope_atr=%.6f price_vs_ema20_atr=%.6f price_vs_ema50_atr=%.6f move3_atr=%.6f move5_atr=%.6f decel3_atr=%.6f body_atr=%.6f wick_body_ratio=%.6f close_location=%.6f confirmed_swing_low=%.3f confirmed_swing_low_shift=%d confirmed_swing_low_time=%s confirmed_swing_high=%.3f confirmed_swing_high_shift=%d confirmed_swing_high_time=%s structure=%.3f origin_high=%.3f origin_low=%.3f lookahead_safe=1 uses_current_bar=0",g_path_id,IsoTime(r[1].time),g_research_bar_count,g_path_name,g_path_buy?"BUY":"SELL",r[1].open,r[1].high,r[1].low,r[1].close,r[2].open,r[2].high,r[2].low,r[2].close,current_r,bar_mfe_r,bar_mae_r,g_research_mfe_r,g_research_mae_r,giveback,giveback_pct,g_research_bar_count,g_research_bar_count-g_research_mfe_bar,(g_research_hit05_bar>0?g_research_bar_count-g_research_hit05_bar:-1),(g_research_hit10_bar>0?g_research_bar_count-g_research_hit10_bar:-1),(g_research_hit15_bar>0?g_research_bar_count-g_research_hit15_bar:-1),(g_research_hit20_bar>0?g_research_bar_count-g_research_hit20_bar:-1),atr,atr_ratio,ema20,ema50,ema20s,ema50s,(ema20>0?(close-ema20)/atr:0),(ema50>0?(close-ema50)/atr:0),move3,move5,move3-prev3,body/atr,wick_body,close_location,swing_low,swing_low_shift,IsoTime(swing_low_time),swing_high,swing_high_shift,IsoTime(swing_high_time),g_path_structure,g_path_origin_high,g_path_origin_low);}
double ResearchTrailingTrigger(){if(InpResearchTrailingMode==1||InpResearchTrailingMode==4)return 1.0;if(InpResearchTrailingMode==2||InpResearchTrailingMode==5||InpResearchTrailingMode==6)return 1.5;if(InpResearchTrailingMode==3)return 2.0;return 0.0;}
string ResearchTrailingRule(){if(InpResearchTrailingMode==1)return "T1_STRUCT_1R";if(InpResearchTrailingMode==2)return "T2_STRUCT_1_5R";if(InpResearchTrailingMode==3)return "T3_STRUCT_2R";if(InpResearchTrailingMode==4)return "T4_ATR_1R";if(InpResearchTrailingMode==5)return "T5_ATR_1_5R";if(InpResearchTrailingMode==6)return "T6_HYBRID_1_5R";return "NONE";}
bool ResearchRecentConfirmedSwing(bool buy,double &level,int &shift,datetime &swing_time){MqlRates r[];if(!LoadRates(InpPatternTF,80,r))return false;for(int i=3;i<60;i++){if(buy&&SwingLow(r,i,2)){level=r[i].low;shift=i;swing_time=r[i].time;return true;}if(!buy&&SwingHigh(r,i,2)){level=r[i].high;shift=i;swing_time=r[i].time;return true;}}return false;}
bool ResearchTrailingStopOK(bool buy,const MqlTick &t,double new_sl){double point=SymbolInfoDouble(_Symbol,SYMBOL_POINT);int stops=(int)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL);double min_dist=(point>0?stops*point:0);if(buy){if(new_sl<=g_path_sl)return false;if(new_sl>=t.bid-min_dist)return false;}else{if(new_sl>=g_path_sl)return false;if(new_sl<=t.ask+min_dist)return false;}return true;}
void ManageResearchTrailing(){if(InpResearchTrailingMode<=0||!g_path_active||g_path_sl_dist<=0)return;if(!ManagementMarketOpen(g_path_buy))return;MqlTick t;if(!SymbolInfoTick(_Symbol,t))return;double trigger=ResearchTrailingTrigger();double trigger_r=g_path_buy?(t.bid-g_path_entry)/g_path_sl_dist:(g_path_entry-t.ask)/g_path_sl_dist;if(trigger<=0||trigger_r<trigger)return;double atr=ATR(InpPatternTF,InpATRPeriod,1);if(atr<=0)return;double new_sl=0,swing=0;int swing_shift=0;datetime swing_time=0;bool structural=(InpResearchTrailingMode==1||InpResearchTrailingMode==2||InpResearchTrailingMode==3||InpResearchTrailingMode==6);if(structural){if(!ResearchRecentConfirmedSwing(g_path_buy,swing,swing_shift,swing_time))return;double stop_buffer=atr*InpStopBufferATR;new_sl=g_path_buy?swing-stop_buffer:swing+stop_buffer;if(InpResearchTrailingMode==6)new_sl=g_path_buy?MathMax(new_sl,g_path_entry):MathMin(new_sl,g_path_entry);}else{new_sl=g_path_buy?t.bid-1.5*atr:t.ask+1.5*atr;}new_sl=NPrice(new_sl);if(!ResearchTrailingStopOK(g_path_buy,t,new_sl))return;trade.SetExpertMagicNumber(InpMagicNumber);trade.SetDeviationInPoints(InpSlippagePoints);double old_sl=g_path_sl;string rule=ResearchTrailingRule();bool sent=trade.PositionModify(_Symbol,new_sl,g_path_tp);uint rc=trade.ResultRetcode();bool ok=sent||rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_PLACED;if(ok){diag_management_actions++;g_path_sl=new_sl;g_path_last_trail_bar=iTime(_Symbol,InpPatternTF,1);PrintFormat("PATTERN_MANAGEMENT id=%d timestamp=%s name=%s rule=%s mode=%d trigger_r=%.6f activation_r=%.6f old_sl=%.3f new_sl=%.3f initial_sl=%.3f tp=%.3f atr=%.6f swing_price=%.3f swing_shift=%d swing_time=%s lookahead_safe=1 never_loosen=1 result=OK retcode=%u",g_path_id,IsoTime(TimeCurrent()),g_path_name,rule,InpResearchTrailingMode,trigger_r,trigger,old_sl,new_sl,g_path_initial_sl,g_path_tp,atr,swing,swing_shift,IsoTime(swing_time),rc);}else{diag_management_failures++;PrintFormat("PATTERN_MANAGEMENT id=%d timestamp=%s name=%s rule=%s mode=%d trigger_r=%.6f activation_r=%.6f old_sl=%.3f new_sl=%.3f initial_sl=%.3f tp=%.3f atr=%.6f swing_price=%.3f swing_shift=%d swing_time=%s lookahead_safe=1 never_loosen=1 result=FAIL retcode=%u description=%s",g_path_id,IsoTime(TimeCurrent()),g_path_name,rule,InpResearchTrailingMode,trigger_r,trigger,old_sl,new_sl,g_path_initial_sl,g_path_tp,atr,swing,swing_shift,IsoTime(swing_time),rc,trade.ResultRetcodeDescription());}}
void ManageValidationPosition(){if(!InpValidationLSSLock025After1R||!g_path_active||g_path_lock025_applied||g_path_name!="LIQUIDITY_SWEEP_SELL"||g_path_buy||g_path_sl_dist<=0)return;if(!ManagementMarketOpen(g_path_buy))return;MqlTick t;if(!SymbolInfoTick(_Symbol,t))return;double trigger_r=(g_path_entry-t.ask)/g_path_sl_dist;if(trigger_r<1.0)return;double new_sl=NPrice(g_path_entry-0.25*g_path_sl_dist);if(new_sl>=g_path_sl||new_sl<=t.ask)return;trade.SetExpertMagicNumber(InpMagicNumber);trade.SetDeviationInPoints(InpSlippagePoints);bool sent=trade.PositionModify(_Symbol,new_sl,g_path_tp);uint rc=trade.ResultRetcode();bool ok=sent||rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_PLACED;if(ok){diag_management_actions++;g_path_sl=new_sl;g_path_lock025_applied=true;PrintFormat("PATTERN_MANAGEMENT id=%d timestamp=%s name=%s rule=LOCK_0_25_AFTER_1R trigger_r=%.6f old_sl=%.3f new_sl=%.3f tp=%.3f result=OK retcode=%u",g_path_id,IsoTime(TimeCurrent()),g_path_name,trigger_r,g_path_entry+g_path_sl_dist,new_sl,g_path_tp,rc);}else{diag_management_failures++;PrintFormat("PATTERN_MANAGEMENT id=%d timestamp=%s name=%s rule=LOCK_0_25_AFTER_1R trigger_r=%.6f old_sl=%.3f new_sl=%.3f tp=%.3f result=FAIL retcode=%u description=%s",g_path_id,IsoTime(TimeCurrent()),g_path_name,trigger_r,g_path_entry+g_path_sl_dist,new_sl,g_path_tp,rc,trade.ResultRetcodeDescription());}}
int LevelFailurePatternId(){if(g_path_name=="BREAKOUT_RETEST_BUY")return 11;if(g_path_name=="LIQUIDITY_SWEEP_BUY")return 13;return 0;}
string LevelFailureRule(){if(InpLevelFailureExitMode==1)return "LF_FULL_EXIT";if(InpLevelFailureExitMode==2)return "LF_PARTIAL_50";if(InpLevelFailureExitMode==3)return "LF_PARTIAL_75";if(InpLevelFailureExitMode==4)return "LF_TO_BREAKEVEN";if(InpLevelFailureExitMode==5)return "LF_STRUCTURE_CONFIRM";if(InpLevelFailureExitMode==6)return "LF_TWO_CLOSES";return "NONE";}
bool CurrentLevelFailure(MqlRates &r[]){return g_path_buy&&g_path_structure>0&&r[1].close<g_path_structure;}
bool CurrentStructureBreak(MqlRates &r[],double &swing_low,int &swing_shift,datetime &swing_time){swing_low=0;swing_shift=0;swing_time=0;if(!g_path_buy)return false;if(!ResearchRecentConfirmedSwing(true,swing_low,swing_shift,swing_time))return false;return swing_low>0&&r[1].close<swing_low;}
double VolumeFloor(double volume,double step){if(step<=0)return volume;return NormalizeDouble(MathFloor(volume/step+0.000000001)*step,8);}
double PartialCloseVolume(double fraction){if(!PositionSelect(_Symbol))return 0;double volume=PositionGetDouble(POSITION_VOLUME);double min_volume=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_MIN);double step=SymbolInfoDouble(_Symbol,SYMBOL_VOLUME_STEP);double close_volume=VolumeFloor(volume*fraction,step);if(close_volume<min_volume)return 0;double remaining=volume-close_volume;if(remaining>0&&remaining<min_volume)close_volume=volume;return NormalizeDouble(close_volume,8);}
void LogLevelFailureManagement(string result,uint rc,string description,string action,double trigger_r,double close_price,double old_sl,double new_sl,double fraction,double close_volume,double swing_low,int swing_shift,datetime swing_time,bool structure_break,int consecutive){double giveback=g_research_mfe_r-trigger_r;PrintFormat("PATTERN_MANAGEMENT id=%d timestamp=%s name=%s rule=%s mode=%d action=%s pattern_id=%d trigger_r=%.6f running_mfe_r=%.6f giveback_r=%.6f bars_since_entry=%d bars_since_mfe=%d level=%.3f close=%.3f structure_break=%d swing_low=%.3f swing_shift=%d swing_time=%s consecutive_level_failure=%d fraction=%.2f close_volume=%.2f old_sl=%.3f new_sl=%.3f tp=%.3f lookahead_safe=1 uses_current_bar=0 never_loosen=1 result=%s retcode=%u description=%s",g_path_id,IsoTime(TimeCurrent()),g_path_name,LevelFailureRule(),InpLevelFailureExitMode,action,LevelFailurePatternId(),trigger_r,g_research_mfe_r,giveback,g_research_bar_count,g_research_bar_count-g_research_mfe_bar,g_path_structure,close_price,structure_break?1:0,swing_low,swing_shift,IsoTime(swing_time),consecutive,fraction,close_volume,old_sl,new_sl,g_path_tp,result,rc,description);}
void ManageLevelFailureExit(){if(InpLevelFailureExitMode<=0||InpLevelFailureManagePatternId<=0||!g_path_active||g_level_failure_managed||g_path_sl_dist<=0)return;if(LevelFailurePatternId()!=InpLevelFailureManagePatternId)return;if(!g_path_buy)return;if(g_research_mfe_r<0.50)return;if(!ManagementMarketOpen(g_path_buy))return;MqlRates r[];if(!LoadRates(InpPatternTF,90,r))return;bool level_failure=CurrentLevelFailure(r);if(level_failure)g_level_failure_consecutive++;else{g_level_failure_consecutive=0;return;}double swing_low=0;int swing_shift=0;datetime swing_time=0;bool structure_break=CurrentStructureBreak(r,swing_low,swing_shift,swing_time);if(InpLevelFailureExitMode==5&&!structure_break)return;if(InpLevelFailureExitMode==6&&g_level_failure_consecutive<2)return;MqlTick t;if(!SymbolInfoTick(_Symbol,t))return;double trigger_r=(t.bid-g_path_entry)/g_path_sl_dist;double close_price=t.bid;trade.SetExpertMagicNumber(InpMagicNumber);trade.SetDeviationInPoints(InpSlippagePoints);double old_sl=g_path_sl,new_sl=g_path_sl,fraction=1.0,close_volume=0;string action="FULL_EXIT";bool sent=false;if(InpLevelFailureExitMode==2||InpLevelFailureExitMode==3){fraction=(InpLevelFailureExitMode==2?0.50:0.75);close_volume=PartialCloseVolume(fraction);if(close_volume<=0)return;action=(InpLevelFailureExitMode==2?"PARTIAL_50":"PARTIAL_75");sent=trade.PositionClosePartial(_Symbol,close_volume,InpSlippagePoints);}else if(InpLevelFailureExitMode==4){action="MOVE_TO_BREAKEVEN";fraction=0;new_sl=NPrice(g_path_entry);if(new_sl<=g_path_sl||new_sl>=t.bid)return;sent=trade.PositionModify(_Symbol,new_sl,g_path_tp);}else{close_volume=PositionSelect(_Symbol)?PositionGetDouble(POSITION_VOLUME):0;sent=trade.PositionClose(_Symbol,InpSlippagePoints);}uint rc=trade.ResultRetcode();bool ok=sent||rc==TRADE_RETCODE_DONE||rc==TRADE_RETCODE_PLACED;if(ok){diag_management_actions++;g_level_failure_managed=true;if(InpLevelFailureExitMode==4)g_path_sl=new_sl;LogLevelFailureManagement("OK",rc,"",action,trigger_r,close_price,old_sl,new_sl,fraction,close_volume,swing_low,swing_shift,swing_time,structure_break,g_level_failure_consecutive);}else{diag_management_failures++;LogLevelFailureManagement("FAIL",rc,trade.ResultRetcodeDescription(),action,trigger_r,close_price,old_sl,new_sl,fraction,close_volume,swing_low,swing_shift,swing_time,structure_break,g_level_failure_consecutive);}}
void PathLogAndClear(datetime exit_time,double exit_price){if(!g_path_active)return;PathUpdatePrice(exit_price);double mfe_r=(g_path_sl_dist>0?g_path_mfe/g_path_sl_dist:0),mae_r=(g_path_sl_dist>0?g_path_mae/g_path_sl_dist:0);int seconds=(int)(exit_time-g_path_entry_time),period=PeriodSeconds(InpPatternTF);if(seconds<0)seconds=0;int bars=(period>0?(int)MathCeil((double)seconds/(double)period):0);PrintFormat("PATTERN_PATH id=%d entry_timestamp=%s exit_timestamp=%s mfe=%.3f mae=%.3f mfe_r=%.6f mae_r=%.6f bars_until_exit=%d seconds_until_exit=%d max_favorable_price=%.3f max_adverse_price=%.3f moved_0_25r=%d moved_0_50r=%d moved_0_75r=%d moved_1_00r=%d moved_1_50r=%d be_after_0_50r=%d be_after_0_75r=%d be_after_1_00r=%d be_after_1_50r=%d lock_0_25_after_1_00r=%d",g_path_id,IsoTime(g_path_entry_time),IsoTime(exit_time),g_path_mfe,g_path_mae,mfe_r,mae_r,bars,seconds,g_path_max_fav_price,g_path_max_adv_price,g_path_hit025?1:0,g_path_hit050?1:0,g_path_hit075?1:0,g_path_hit100?1:0,g_path_hit150?1:0,g_path_be_after050?1:0,g_path_be_after075?1:0,g_path_be_after100?1:0,g_path_be_after150?1:0,g_path_lock025_after100?1:0);g_path_active=false;}

bool MarketOpen(bool buy){ENUM_SYMBOL_TRADE_MODE mode=(ENUM_SYMBOL_TRADE_MODE)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_MODE);if(mode==SYMBOL_TRADE_MODE_DISABLED||mode==SYMBOL_TRADE_MODE_CLOSEONLY||(buy&&mode==SYMBOL_TRADE_MODE_SHORTONLY)||(!buy&&mode==SYMBOL_TRADE_MODE_LONGONLY)){diag_market_session++;return false;}MqlDateTime dt;TimeToStruct(TimeCurrent(),dt);int now=dt.hour*3600+dt.min*60+dt.sec;datetime from,to;uint sessions=0;for(uint i=0;SymbolInfoSessionTrade(_Symbol,(ENUM_DAY_OF_WEEK)dt.day_of_week,i,from,to);i++){sessions++;int start=(int)from,end=(int)to;if((start<=end&&now>=start&&now<end)||(start>end&&(now>=start||now<end)))return true;}if(sessions==0)return true;diag_market_session++;return false;}
bool ManagementMarketOpen(bool buy){ENUM_SYMBOL_TRADE_MODE mode=(ENUM_SYMBOL_TRADE_MODE)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_MODE);if(mode==SYMBOL_TRADE_MODE_DISABLED||mode==SYMBOL_TRADE_MODE_CLOSEONLY||(buy&&mode==SYMBOL_TRADE_MODE_SHORTONLY)||(!buy&&mode==SYMBOL_TRADE_MODE_LONGONLY))return false;MqlDateTime dt;TimeToStruct(TimeCurrent(),dt);int now=dt.hour*3600+dt.min*60+dt.sec;datetime from,to;uint sessions=0;for(uint i=0;SymbolInfoSessionTrade(_Symbol,(ENUM_DAY_OF_WEEK)dt.day_of_week,i,from,to);i++){sessions++;int start=(int)from,end=(int)to;if((start<=end&&now>=start&&now<end)||(start>end&&(now>=start||now<end)))return true;}return sessions==0;}
bool StopsOK(bool buy,const MqlTick &t,double sl,double tp){double point=SymbolInfoDouble(_Symbol,SYMBOL_POINT);int stops=(int)SymbolInfoInteger(_Symbol,SYMBOL_TRADE_STOPS_LEVEL);if(point<=0)return false;double min_dist=stops*point;if(min_dist<=0)return true;if(buy){if(t.bid-sl<=min_dist||tp-t.bid<=min_dist){diag_invalid_stop++;return false;}}else{if(sl-t.ask<=min_dist||t.ask-tp<=min_dist){diag_invalid_stop++;return false;}}return true;}
void SetRequestFilling(MqlTradeRequest &req){int filling=(int)SymbolInfoInteger(_Symbol,SYMBOL_FILLING_MODE);if((filling&SYMBOL_FILLING_FOK)==SYMBOL_FILLING_FOK)req.type_filling=ORDER_FILLING_FOK;else if((filling&SYMBOL_FILLING_IOC)==SYMBOL_FILLING_IOC)req.type_filling=ORDER_FILLING_IOC;else req.type_filling=ORDER_FILLING_RETURN;}
bool OrderPrecheckOK(string name,bool buy,double vol,double entry,double sl,double tp){MqlTradeRequest req;MqlTradeCheckResult chk;ZeroMemory(req);ZeroMemory(chk);req.action=TRADE_ACTION_DEAL;req.symbol=_Symbol;req.magic=InpMagicNumber;req.volume=vol;req.type=buy?ORDER_TYPE_BUY:ORDER_TYPE_SELL;req.price=entry;req.sl=sl;req.tp=tp;req.deviation=InpSlippagePoints;req.type_time=ORDER_TIME_GTC;req.comment="PATTERN_"+name;SetRequestFilling(req);if(!OrderCheck(req,chk)){diag_order_check_failed++;PrintFormat("PATTERN_ORDER_CHECK_FAILED name=%s last_error=%d",name,GetLastError());return false;}if(chk.retcode==0||chk.retcode==TRADE_RETCODE_DONE||chk.retcode==TRADE_RETCODE_PLACED)return true;if(chk.retcode==TRADE_RETCODE_INVALID_STOPS)diag_invalid_stop++;else if(chk.retcode==TRADE_RETCODE_MARKET_CLOSED||chk.retcode==TRADE_RETCODE_TRADE_DISABLED)diag_market_session++;else diag_order_check_failed++;PrintFormat("PATTERN_ORDER_CHECK_REJECTED name=%s retcode=%u comment=%s",name,chk.retcode,chk.comment);return false;}
bool Execute(PatternSignal &s){if((s.buy&&!InpAllowBuy)||(!s.buy&& !InpAllowSell)){diag_signal_disabled++;return false;}if(!SpreadOK())return false;if(!MarketOpen(s.buy))return false;if(InpOnePositionOnly&&HasPosition()){diag_existing_position++;return false;}if(!DailyOK())return false;MqlTick t;if(!SymbolInfoTick(_Symbol,t)){diag_tick_missing++;return false;}double entry=NPrice(s.buy?t.ask:t.bid),sl=NPrice(s.sl),tp=NPrice(s.tp);if((s.buy&&(sl>=entry||tp<=entry))||(!s.buy&&(sl<=entry||tp>=entry))){diag_invalid_stop++;return false;}if(!StopsOK(s.buy,t,sl,tp))return false;double sd=MathAbs(entry-sl),td=MathAbs(tp-entry);if(sd<=0||td/sd<InpMinimumRR){diag_rr_rejected++;diag_execution_rr_rejected++;return false;}double vol=Volume(s.buy,entry,sl);if(vol<=0){diag_sizing_rejected++;return false;}if(!OrderPrecheckOK(s.name,s.buy,vol,entry,sl,tp))return false;double risk_cash=RiskCash(s.buy,vol,entry,sl);double spread_price=MathAbs(t.ask-t.bid);double point=SymbolInfoDouble(_Symbol,SYMBOL_POINT);double spread_points=(point>0?spread_price/point:0);int plan_id=g_next_plan_id++;LogTradeFeature(plan_id,s,td/sd,td);PrintFormat("PATTERN_PLAN id=%d bar=%s timestamp=%s name=%s direction=%s volume=%.2f entry=%.3f sl=%.3f tp=%.3f rr=%.2f sl_dist=%.3f tp_dist=%.3f risk_cash=%.2f spread_price=%.6f spread_points=%.2f quote_bid=%.3f quote_ask=%.3f",plan_id,BarKey(),BarTimestamp(),s.name,s.buy?"BUY":"SELL",vol,entry,sl,tp,td/sd,sd,td,risk_cash,spread_price,spread_points,t.bid,t.ask);trade.SetExpertMagicNumber(InpMagicNumber);trade.SetDeviationInPoints(InpSlippagePoints);g_pending_plan_id=plan_id;g_pending_buy=s.buy;g_pending_sl=sl;g_pending_tp=tp;g_pending_sl_dist=sd;g_pending_name=s.name;g_pending_structure=s.structure_price;g_pending_origin_high=0;g_pending_origin_low=0;MqlRates pr[];if(LoadRates(InpPatternTF,5,pr)){g_pending_origin_high=pr[1].high;g_pending_origin_low=pr[1].low;}diag_orders_attempted++;bool ok=s.buy?trade.Buy(vol,_Symbol,entry,sl,tp,"PATTERN_"+s.name):trade.Sell(vol,_Symbol,entry,sl,tp,"PATTERN_"+s.name);if(ok){diag_orders_success++;if(!g_path_active)PathInit(plan_id,s.buy,entry,sl,tp,TimeCurrent());if(g_pending_plan_id==plan_id)g_pending_plan_id=0;PrintFormat("PATTERN_ENTRY id=%d bar=%s timestamp=%s name=%s direction=%s volume=%.2f entry=%.3f sl=%.3f tp=%.3f rr=%.2f sl_dist=%.3f tp_dist=%.3f risk_cash=%.2f spread_price=%.6f spread_points=%.2f quote_bid=%.3f quote_ask=%.3f",plan_id,BarKey(),BarTimestamp(),s.name,s.buy?"BUY":"SELL",vol,entry,sl,tp,td/sd,sd,td,risk_cash,spread_price,spread_points,t.bid,t.ask);return true;}if(g_pending_plan_id==plan_id)g_pending_plan_id=0;g_pending_name="";diag_orders_failed++;PrintFormat("PATTERN_ORDER_FAILED id=%d name=%s retcode=%u description=%s",plan_id,s.name,trade.ResultRetcode(),trade.ResultRetcodeDescription());return false;}

void Evaluate(){diag_bars++;string reason="";if(Blocked(reason)){PrintFormat("PATTERN_BLOCK reason=%s",reason);return;}PatternSignal detected[];DetectAll(detected);if(ArraySize(detected)==0){diag_no_pattern++;return;}PatternSignal valid[];FilterRR(detected,valid);if(ArraySize(valid)==0){diag_no_pattern++;return;}if(Conflict(valid))diag_direction_conflict++;if(ArraySize(valid)==1)diag_single_candidate++;else diag_multiple_candidates++;int i=Best(valid);if(i>=0){PrintFormat("PATTERN_SELECTED bar=%s name=%s direction=%s entry=%.3f sl=%.3f tp=%.3f rr=%.2f sl_dist=%.3f tp_dist=%.3f score=%.6f",BarKey(),valid[i].name,valid[i].buy?"BUY":"SELL",valid[i].entry,valid[i].sl,valid[i].tp,valid[i].rr,valid[i].sl_distance,valid[i].tp_distance,valid[i].score);Execute(valid[i]);}}
bool NewBar(){datetime t=iTime(_Symbol,InpPatternTF,0);if(t==0||t==g_last_bar_time)return false;g_last_bar_time=t;return true;}

void PrintDiag(){PrintFormat("PATTERN_DIAGNOSTIC bars_evaluated=%d",diag_bars);PrintFormat("PATTERN_DIAGNOSTIC sideway=%d choppy=%d compression=%d low_volatility=%d conflicting_trend=%d extended_move=%d",diag_block_sideway,diag_block_choppy,diag_block_compression,diag_block_low_vol,diag_block_conflict,diag_block_extended);PrintFormat("PATTERN_DIAGNOSTIC double_bottom=%d double_top=%d head_shoulders=%d inverse_head_shoulders=%d bull_flag=%d bear_flag=%d ascending_triangle=%d descending_triangle=%d falling_wedge=%d rising_wedge=%d breakout_retest_buy=%d breakout_retest_sell=%d liquidity_buy=%d liquidity_sell=%d",diag_double_bottom,diag_double_top,diag_hs,diag_inverse_hs,diag_bull_flag,diag_bear_flag,diag_ascending_triangle,diag_descending_triangle,diag_falling_wedge,diag_rising_wedge,diag_breakout_retest_buy,diag_breakout_retest_sell,diag_liquidity_buy,diag_liquidity_sell);PrintFormat("PATTERN_DIAGNOSTIC no_pattern=%d single=%d multiple=%d conflict=%d rr_rejected=%d execution_rr_rejected=%d quality_rejected=%d trend_rejected=%d validation_rejected=%d spread_rejected=%d existing_position=%d daily_risk=%d sizing_rejected=%d invalid_stop=%d market_session=%d order_check_failed=%d signal_disabled=%d tick_missing=%d orders_attempted=%d orders_success=%d orders_failed=%d management_actions=%d management_failures=%d",diag_no_pattern,diag_single_candidate,diag_multiple_candidates,diag_direction_conflict,diag_rr_rejected,diag_execution_rr_rejected,diag_quality_rejected,diag_trend_rejected,diag_validation_rejected,diag_spread_rejected,diag_existing_position,diag_daily_risk,diag_sizing_rejected,diag_invalid_stop,diag_market_session,diag_order_check_failed,diag_signal_disabled,diag_tick_missing,diag_orders_attempted,diag_orders_success,diag_orders_failed,diag_management_actions,diag_management_failures);}
int OnInit(){trade.SetExpertMagicNumber(InpMagicNumber);trade.SetDeviationInPoints(InpSlippagePoints);Print("PatternEngineEA V2 initialized");PrintFormat("PatternEngineEA V2 contribution mask=%d only_pattern=%d sweep_quality_mode=%d quality_scoring=%s validation_br_rr5=%s validation_lss_lock=%s validation_lsb_reclaim=%s trailing_mode=%d trailing_rule=%s path_diagnostics=%s level_failure_mode=%d level_failure_rule=%s level_failure_pattern=%d",InpPatternMask,InpOnlyPattern,InpSweepQualityMode,InpUseQualityScoring?"true":"false",InpValidationBRBuyRejectRR5?"true":"false",InpValidationLSSLock025After1R?"true":"false",InpValidationLSBReclaimOnly?"true":"false",InpResearchTrailingMode,ResearchTrailingRule(),InpResearchPathDiagnostics?"true":"false",InpLevelFailureExitMode,LevelFailureRule(),InpLevelFailureManagePatternId);PrintFormat("PATTERN_TRAILING_AUDIT mode=%d rule=%s confirmed_swing_min_shift=3 uses_current_bar=0 lookahead_safe=1 never_loosen=1 path_diagnostics=%d",InpResearchTrailingMode,ResearchTrailingRule(),InpResearchPathDiagnostics?1:0);PrintFormat("PATTERN_LEVEL_FAILURE_AUDIT mode=%d rule=%s manage_pattern_id=%d activation_r=0.50 close_below_structure=1 uses_closed_m15=1 uses_current_bar=0 lookahead_safe=1",InpLevelFailureExitMode,LevelFailureRule(),InpLevelFailureManagePatternId);return INIT_SUCCEEDED;}
void OnTick(){PathUpdateTick();ManageValidationPosition();ManageResearchTrailing();if(NewBar()){LogResearchPathBar();ManageLevelFailureExit();Evaluate();}}
void OnTradeTransaction(const MqlTradeTransaction &trans,const MqlTradeRequest &request,const MqlTradeResult &result){if(trans.type!=TRADE_TRANSACTION_DEAL_ADD||trans.deal==0)return;if(!HistoryDealSelect(trans.deal))return;if(HistoryDealGetString(trans.deal,DEAL_SYMBOL)!=_Symbol)return;ENUM_DEAL_ENTRY entry=(ENUM_DEAL_ENTRY)HistoryDealGetInteger(trans.deal,DEAL_ENTRY);if(entry!=DEAL_ENTRY_IN&&entry!=DEAL_ENTRY_OUT&&entry!=DEAL_ENTRY_INOUT&&entry!=DEAL_ENTRY_OUT_BY)return;ENUM_DEAL_TYPE type=(ENUM_DEAL_TYPE)HistoryDealGetInteger(trans.deal,DEAL_TYPE);if(type!=DEAL_TYPE_BUY&&type!=DEAL_TYPE_SELL)return;long magic=HistoryDealGetInteger(trans.deal,DEAL_MAGIC);if(magic!=(long)InpMagicNumber&&entry==DEAL_ENTRY_IN)return;ENUM_DEAL_REASON reason=(ENUM_DEAL_REASON)HistoryDealGetInteger(trans.deal,DEAL_REASON);datetime deal_time=(datetime)HistoryDealGetInteger(trans.deal,DEAL_TIME);double volume=HistoryDealGetDouble(trans.deal,DEAL_VOLUME),price=HistoryDealGetDouble(trans.deal,DEAL_PRICE),profit=HistoryDealGetDouble(trans.deal,DEAL_PROFIT),commission=HistoryDealGetDouble(trans.deal,DEAL_COMMISSION),swap=HistoryDealGetDouble(trans.deal,DEAL_SWAP);string comment=HistoryDealGetString(trans.deal,DEAL_COMMENT);if((entry==DEAL_ENTRY_IN||entry==DEAL_ENTRY_INOUT)&&g_pending_plan_id>0)PathInit(g_pending_plan_id,g_pending_buy,price,g_pending_sl,g_pending_tp,deal_time);if(entry==DEAL_ENTRY_OUT||entry==DEAL_ENTRY_OUT_BY){bool still_open=false;if(PositionSelect(_Symbol)){long pmagic=PositionGetInteger(POSITION_MAGIC);double pvolume=PositionGetDouble(POSITION_VOLUME);still_open=(pmagic==(long)InpMagicNumber&&pvolume>0);}if(!still_open)PathLogAndClear(deal_time,price);}PrintFormat("PATTERN_DEAL date=%s entry=%s type=%s reason=%s magic=%d volume=%.2f price=%.3f profit=%.2f commission=%.2f swap=%.2f comment=%s",TimeToString(deal_time,TIME_DATE),EnumToString(entry),EnumToString(type),EnumToString(reason),magic,volume,price,profit,commission,swap,comment);}
void OnDeinit(const int reason){PrintDiag();PrintFormat("PatternEngineEA deinit reason=%d",reason);}
